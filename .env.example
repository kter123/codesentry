# CodeSentry 本机环境变量样例（真实 .env 不进仓库）
# —— 数据库（Postgres 单实例分 schema，pgvector）
CODESENTRY_DATABASE_URL=postgresql://codesentry:CHANGE_ME@127.0.0.1:5432/codesentry

# —— LLM（OpenAI 兼容；平台不预置任何厂商 key，D5 用户自配）
# 例1 DeepSeek: https://api.deepseek.com/v1 + deepseek-chat
# 例2 OpenCode Go: https://opencode.ai/zen/go/v1 + glm-5.3（模型 id 不带 opencode-go/ 前缀；
#    需 x-opencode-session 头，建议在 WebUI 的 LLM Profile 中配置，见 docs/superpowers/specs/2026-10-20-opencode-go-provider-design.md）
CODESENTRY_MODEL_BASE_URL=
CODESENTRY_MODEL_API_KEY=
CODESENTRY_FAST_MODEL=
CODESENTRY_DEEP_MODEL=
CODESENTRY_TEMPERATURE=0

# —— M6.1 控制面
# 主密钥：加密 LLM API Key + JWT 签名；不设则自动生成 <work_dir>/.secret_key（0600）
CODESENTRY_SECRET_KEY=
# 默认关闭（本地单机）；绑定非回环地址时必须开启
CODESENTRY_AUTH_ENABLED=false
# 认证开启且无用户时引导管理员
CODESENTRY_ADMIN_PASSWORD=
CODESENTRY_ADMIN_USER=admin
# 可选：OpenCode Go 原始密钥（也可在 WebUI/DB 的 LLM Profile 中配置）
# OPENCODE_GO_API_KEY=

# —— M6.2 Docker 部署（上传 Web 包后默认部署）
CODESENTRY_DEPLOY_ENABLED=true
# host: 仅发布 127.0.0.1 随机端口，浏览器可访问；internal: 严格沙箱，PoC 在容器内执行
CODESENTRY_DEPLOY_NETWORK_MODE=host
CODESENTRY_DEPLOY_PORT=8080
# true: 扫描结束保留容器供人工检查（默认 false 自动清理）
CODESENTRY_DEPLOY_KEEP=false
# 可指向本机/私有镜像，避免 Docker Hub 拉取超时
CODESENTRY_DEPLOY_PYTHON_IMAGE=python:3.12-slim
CODESENTRY_DEPLOY_PHP_IMAGE=php:8.3-cli
CODESENTRY_DEPLOY_JAVASCRIPT_IMAGE=node:20-slim

# —— 引擎二进制路径（M4 默认 PATH 内；自定义时显式给出）
CODESENTRY_CODEQL_BIN=
CODESENTRY_JOERN_BIN=
CODESENTRY_SEMGREP_BIN=

# —— Embedding 双通道（M2/D10）：独立 OpenAI 兼容端点；本地走 ollama（bge-m3 已部署挂载盘）
# 例（本地 ollama）：CODESENTRY_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1  CODESENTRY_EMBEDDING_MODEL=bge-m3
CODESENTRY_EMBEDDING_BASE_URL=
CODESENTRY_EMBEDDING_MODEL=
CODESENTRY_EMBEDDING_API_KEY=

# —— License Gate（FR-3，OSS=true 则跳过 Joern/CodeQL 闭源检查）
# ——其它可选项见 src/codesentry/config.py
