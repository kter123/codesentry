# ---- CodeQL ----
CODESENTRY_CODEQL_BIN=codeql
CODESENTRY_LANGUAGE=java-kotlin
CODESENTRY_DB_BUILD_MODE=autobuild
CODESENTRY_BUILD_COMMAND=
CODESENTRY_QUERY_PACK=codeql/java-queries:codeql-suites/java-security-extended.qls
CODESENTRY_CODEQL_TIMEOUT=3600
CODESENTRY_QUERY_TIMEOUT=300

# ---- Audit budget ----
CODESENTRY_MAX_FINDINGS=200
CODESENTRY_MAX_TOKENS=500000
CODESENTRY_MAX_TOOL_CALLS=500
CODESENTRY_MAX_COST_USD=10
CODESENTRY_HUMAN_REVIEW=false

# ---- LLM (M2+) ----
CODESENTRY_MODEL_PROVIDER=openai
CODESENTRY_MODEL_BASE_URL=
CODESENTRY_FAST_MODEL=
CODESENTRY_DEEP_MODEL=
CODESENTRY_MODEL_API_KEY=
CODESENTRY_TEMPERATURE=0
CODESENTRY_MAX_TOOL_STEPS=8
CODESENTRY_MAX_EVIDENCE_CHARS=60000

# ---- Paths ----
CODESENTRY_WORK_DIR=.codesentry
